# Copy to .env (kept out of git) and fill in.
# Leave MQTT_URL empty to use the local dev broker (npm run broker) instead of the cloud.

# EMQX Cloud Serverless: Deployment > Overview > connection address, MQTT over TLS port 8883.
# Example: mqtts://abc1234.ala.asia-southeast1.emqxsl.com:8883
MQTT_URL=

# Publisher for the virtual PLC fleet (Access Control > Client Authentication).
# Its authorization rule: publish only, topic pdm/v1/#
MQTT_USERNAME=
MQTT_PASSWORD=

# Subscriber for `npm run tap` (and later the ingestion service).
# Its authorization rule: subscribe only, topic pdm/v1/#
MQTT_TAP_USERNAME=
MQTT_TAP_PASSWORD=
