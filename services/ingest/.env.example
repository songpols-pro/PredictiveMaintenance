# Copy to .env (kept out of git) and fill in.

# MQTT broker, as the subscriber user ("ingest": subscribe only, topic pdm/v1/#).
# Leave MQTT_URL empty to use the local dev broker (services/virtual-plc: npm run broker).
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
# One id per environment (this computer, Cloud Run): the broker keeps a persistent session per id,
# and two running copies with the same id would keep taking the session from each other.
MQTT_CLIENT_ID=pdm-ingest-local

# Tiger Cloud (TimescaleDB): service > Connect > connection string.
# Example: postgres://tsdbadmin:<password>@abc123.xyz.tsdb.cloud.timescale.com:34567/tsdb?sslmode=require
DATABASE_URL=

# History policies. Development (free tier, 750 MB): compress after 1 day, keep 30 days.
# Production: COMPRESS_AFTER=7 days and RETENTION empty (keep everything for the PdM models).
COMPRESS_AFTER=1 day
RETENTION=30 days

# Live view in Firestore (latest values, gateway state, active alarms); empty = history only.
# Credentials: gcloud auth application-default login (locally), the service account on Cloud Run.
FIREBASE_PROJECT_ID=

# Alarm emails (src/notify.ts): "on" queues emails in Firestore "mail" for the plants whose alarm
# emails are on (admin page, Plants tab). The "Trigger Email from Firestore" extension sends them.
# Turn it on in one environment only (the deployed service); development machines leave it off.
NOTIFY_EMAIL=off
# Address of the web app for the link in the emails, e.g. https://<backend>.<region>.hosted.app
NOTIFY_SITE_URL=
