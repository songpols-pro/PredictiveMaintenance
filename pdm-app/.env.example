# Copy to .env.local for local development. On Firebase App Hosting none of this is needed.
#
# Without any of these, the demo request form works but stores nothing (development only;
# a production build without Firestore shows a "couldn't send" message instead).

# Option A: Firestore emulator (no Firebase project needed). Start it with
#   npx firebase-tools emulators:start --only firestore --project demo-pdm-monitor
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# GCLOUD_PROJECT=demo-pdm-monitor

# Option B: a real Firebase project, using a service account key file (keep it out of git).
# GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Email every demo request through the "Trigger Email from Firestore" extension.
# LEADS_NOTIFY_EMAIL=sales@your-company.co.th

# /hvac chiller plant module ------------------------------------------------------------------
# Public Firebase web config (Firebase console > Project settings > Your apps > web app "pop").
# Public by design: access is decided by sign-in and firestore.rules. On App Hosting these are set
# in apphosting.yaml.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pdm-app-87193.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=pdm-app-87193
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Data source: live (default; sign-in, Firestore + TimescaleDB) or sim (built-in simulation, no sign-in).
# NEXT_PUBLIC_HVAC_SOURCE=sim
