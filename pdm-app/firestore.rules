rules_version = '2';

// Browsers get no direct access to Firestore.
// Demo requests are written by the website's server code with the Firebase Admin SDK
// (src/lib/leads.ts), which is not subject to these rules. Read them in the Firebase console.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
